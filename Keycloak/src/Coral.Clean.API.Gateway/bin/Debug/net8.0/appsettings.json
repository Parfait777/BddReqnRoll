{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiKeyAuthOptions": {
    "ClientIdHeader": "X-Client-Id",
    "ApiKeyHeader": "X-API-KEY",
    "StripCredentialsBeforeForwarding": true,
    "Enabled": true
  },
  "GatewayOptions": {
    "IpWhitelist": [],
    "TrustForwardedHeaders": true,
    "RequireClientIdHeader": true,
    "RequiredApiKeyHeader": true,
    "AllowedContentTypes": [ "application/json" ],
    "AuthenticationExemptPaths": [ "/health", "/errors", "/swagger" ]
  }
}