{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GatewayOptions": {
    "IpWhitelist": [
      "127.0.0.1/32"
    ],
    "TrustForwardedHeaders": true,
    "MaxBodyBytes": 10485760,
    "RequireClientIdHeader": true,
    "AllowedContentTypes": [ "application/json", "multipart/form-data" ]
  },
  "DownstreamHealthOptions": {
    "FailReadinessOnAnyFailure": true,
    "Endpoints": [
      {
        "Name": "coral-api-ready",
        "Url": "https://localhost:6001/health/ready",
        "TimeoutInSeconds": 5
      }
    ]
  },
  "OcelotConfigName" :  "ocelot.Development.json"
  ,
  "ApiKeyAuthOptions": {
    "Enabled": true,
    "ClientIdHeader": "X-Client-Id",
    "ApiKeyHeader": "X-Api-Key",
    "StripCredentialsBeforeForwarding": true,
    "ApiKeysAreSha256Hex": true
  },
  "KeycloakOptions": {
    "BaseUrl": "https://keycloak.example.com",
    "TokenRequestTimeoutSeconds": 10,
    "TokenExpirySkewSeconds": 30
  },
  "ApiKeyCatalogOptions": {
    "Clients": [
      {
        "ExternalClientId": "ext-client-001",
        "ApiKey": "<sha256-hex-of-your-api-key>",
        "Revoked": false,
        "Realm": "my-realm",
        "KeycloakClientId": "kc-service-client",
        "KeycloakClientSecret": "kc-service-client-secret",
        "Scopes": [ "myapi.read", "myapi.write" ]
      }
    ]
  }
}
